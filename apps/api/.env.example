NODE_ENV=development
PORT=3000
# Required exact frontend origin, without a trailing slash or path.
# Use HTTPS in production.
WEB_ORIGIN=http://127.0.0.1:5173

# Local PostgreSQL: docker compose up -d --wait postgres (from the repository root).
DATABASE_URL=postgresql://holobid:holobid_local@127.0.0.1:55432/holobid
AUDIT_DATABASE_URL=postgresql://holobid_audit:holobid_audit_local@127.0.0.1:55432/holobid_audit
# Optional direct connections for migrations when runtime URLs use a pooler.
# DIRECT_DATABASE_URL=postgresql://...
# DIRECT_AUDIT_DATABASE_URL=postgresql://...

# Required: generate a private key with the command in README. Never commit it.
JWT_SECRET=

# Generate two more independent keys with the same README command. Keep them stable.
AUDIT_HMAC_SECRET=
AUDIT_PSEUDONYM_SECRET=
AUDIT_KEY_ID=v1

# Opt in only for the public simulated evaluation environment.
DEMO_MODE=false
