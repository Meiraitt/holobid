{
  "name": "@holobid/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:auth": "vitest run src/auth/session.integration.test.ts",
    "test:auctions": "vitest run src/views/**/*.integration.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
