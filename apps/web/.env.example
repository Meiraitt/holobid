# Browser-visible configuration. Never put secrets in VITE_* variables.
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# Browser auth calls use same-origin /api/v1/auth via Vite proxy / Vercel rewrite.
# Send credentials: include and X-CSRF-Protection: 1; never persist the JWT here.
