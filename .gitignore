*.log

# Secrets; safe environment templates remain versioned
.env
.env.*
!.env.example
!**/.env.example
!.env.test.example
!**/.env.test.example
secrets/
backups/
*.pem
*.key
*.p12
*.dump

# Local tools and test artifacts
.DS_Store
.idea/
.vscode/
.vercel/
.northflank/
playwright-report/
test-results/
reports/

# Keep README.md, migrations, lockfiles,
# source code, tests and small public seed fixtures versioned.

